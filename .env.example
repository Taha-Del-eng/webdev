SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
JWT_ACCESS_SECONDS=900
JWT_REFRESH_DAYS=14
# Use a shared Redis URL for rate limits in multi-worker production deployments.
RATELIMIT_STORAGE_URI=memory://
DATABASE_URL=sqlite:///yours_mart.db

# Separate admin accounts. Generate hashes with Werkzeug; never commit plain passwords.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yoursmart.local
ADMIN_NAME=Yours Mart Admin
ADMIN_PASSWORD_HASH=

SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@yoursmart.local
SUPERADMIN_NAME=Yours Mart Superadmin
SUPERADMIN_PASSWORD_HASH=

PAYMENT_PROVIDER=easypaisa
PAYMENT_ACCOUNT=03352935407
PAYMENT_ACCOUNT_NAME=Yours Mart
SHIPPING_FEE=250
FREE_SHIPPING_THRESHOLD=5000

# Try-on backend: "provider" is a real external API; "local" fails closed until
# a compatible, licensed local model adapter and weights are installed.
AI_TRYON_BACKEND=provider
AI_API_KEY=
AI_API_URL=https://api.fashn.ai
AI_MODEL=tryon-max
AI_ASSISTANT_API_KEY=
AI_ASSISTANT_API_URL=
AI_ASSISTANT_MODEL=

STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
